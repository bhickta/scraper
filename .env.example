# Scraper Configuration
# Copy this file to .env and fill in your values

# Data directory (default: data)
# SCRAPER_DATA_DIR=data

# GST API base URL (default: https://gst.jamku.app/gstin)
# GST_BASE_URL=https://gst.jamku.app/gstin

# Scraping concurrency (default: 3)
# MAX_WORKERS=3

# Checkpoint batch size (default: 10)
# BATCH_SIZE=10

# Rate limiting
# RATE_LIMIT_BASE_DELAY=1.0
# RATE_LIMIT_MAX_DELAY=10.0

# Retry configuration
# RETRY_ATTEMPTS=5
# RETRY_MIN_WAIT=5
# RETRY_MAX_WAIT=30

# Request delay range (seconds)
# REQUEST_DELAY_MIN=2.0
# REQUEST_DELAY_MAX=5.0
